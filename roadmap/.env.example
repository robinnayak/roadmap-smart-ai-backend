# ==============================================================================
# ROADMAP SMART PLANNER (DAYONEGOAL) - BACKEND CONFIGURATION
# ==============================================================================

# --- Django Core Settings ---
DEBUG=False
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,::1,your-service.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
WHITENOISE_MAX_AGE=31536000

# --- Database (PostgreSQL / Supabase) ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=your-supabase-db-name
DB_USER=your-supabase-db-user
DB_PASSWORD=replace-with-your-supabase-db-password
DB_HOST=your-project-id.supabase.co
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Authentication & JWT ---
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
MAX_ACTIVE_DEVICE_SESSIONS=0
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# --- Cloudflare R2 Object Storage ---
USE_R2_STORAGE=False
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
R2_PUBLIC_BASE_URL=https://pub-YOUR_HASH.r2.dev

# --- LLM Global Configuration ---
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACKS=openrouter:LLAMA_3_3_70B,ollama:GPT_OSS_120B
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_SECONDS=1.0
AI_DEBUG=false

# --- Generic Model Selection (Use these in your Mapping Layer) ---
# Format: [GENERIC_KEY]
HIERARCHY_MODEL=GPT_OSS_120B
JOURNEYBOOK_MODEL=GPT_OSS_120B
TIMELINE_MODEL=GPT_OSS_120B
CURRENT_SITUATION_MODEL=GPT_OSS_120B
GIE_LANGUAGE_MODEL=GPT_OSS_120B
JOURNAL_MODEL=GPT_OSS_120B
HABIT_RECOMMENDATION_MODEL=GPT_OSS_120B
GOAL_ATTRIBUTE_MODEL=GPT_OSS_120B
GOAL_CATEGORY_MODEL=GPT_OSS_120B

# --- Groq Provider ---
GROQ_API_KEY=your-groq-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=LLAMA_3_3_70B

# --- OpenRouter Provider ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=LLAMA_3_3_70B
OPENROUTER_APP_NAME=Roadmap Smart Planner
OPENROUTER_SITE_URL=https://your-frontend-domain.com

# --- Ollama / Local AI Models ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=GPT_OSS_120B
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.75
OLLAMA_TRUST_ENV=false
JOURNAL_AI_PROVIDER=ollama

# --- Roadmap Hierarchy & Business Logic ---
GIE_ROLLOUT_ENABLED=True
GIE_DEGRADED_MODE=False
HIERARCHY_MAX_MONTHS=12
HIERARCHY_MAX_SUBGOALS_PER_MILESTONE=3
HIERARCHY_MAX_TASKS_PER_SUBGOAL=5
HIERARCHY_MAX_TOKENS=2400
HIERARCHY_TASK_WORKERS=2

# --- Email & Communications ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Roadmap Planner <onboarding@example.com>

# --- Monitoring & External Tools ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=False
HUGGINGFACE_API_KEY=replace-with-your-huggingface-api-key