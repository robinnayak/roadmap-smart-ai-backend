# ---------------------------------------
# CORE SETTINGS
# ---------------------------------------

# Enable debug mode for local development (OPTIONAL, default: True)
# Example: True (local dev), False (production)
DEBUG=True

# Django secret key used by the backend (REQUIRED)
# Example: django-insecure-abc123xyz...
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret-key

# Comma-separated hosts allowed by Django (OPTIONAL)
# Example: localhost,127.0.0.1,mydomain.com
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Comma-separated frontend origins allowed by CORS (OPTIONAL)
# Example: http://localhost:3000,https://app.dayonegoal.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------------------------------------
# DATABASE
# ---------------------------------------

# NOTE: Currently using SQLite (roadmap/db.sqlite3)
# Future Example (PostgreSQL / Supabase):
# DB_NAME=dayonegoal
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432


# ---------------------------------------
# EMAIL CONFIGURATION
# ---------------------------------------

# Django email backend class path (OPTIONAL)
# Example: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP host for password reset emails (REQUIRED for real email delivery)
# Example: smtp.gmail.com
EMAIL_HOST=smtp.example.com

# SMTP port (OPTIONAL, default: 587)
# Example: 587 (TLS), 465 (SSL)
EMAIL_PORT=587

# Use TLS for SMTP (OPTIONAL, default: True)
# Example: True
EMAIL_USE_TLS=True

# SMTP username (REQUIRED for real email delivery)
# Example: your-email@gmail.com
EMAIL_HOST_USER=your-smtp-username

# SMTP password or app password (REQUIRED for real email delivery)
# Example: Gmail App Password (not your real password)
EMAIL_HOST_PASSWORD=your-smtp-password

# Default sender address for Django emails (OPTIONAL)
# Example: DayOneGoal <noreply@dayonegoal.com>
DEFAULT_FROM_EMAIL=noreply@example.com

# Frontend URL used to build password reset links (REQUIRED)
# Example: http://localhost:3000/reset-password
PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Resend API key used by commitment contract email delivery (REQUIRED)
# Example: re_123456789abcdef
RESEND_API_KEY=replace-with-your-resend-api-key

# Sender identity used for Resend email delivery (OPTIONAL)
# Example: DayOneGoal <onboarding@resend.dev>
RESEND_FROM_EMAIL=Roadmap Smart Planner <onboarding@example.com>


# ---------------------------------------
# REDIS / CELERY
# ---------------------------------------

# NOTE: Not currently used in code
# Future Example:
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ---------------------------------------
# STORAGE (R2 / CLOUDINARY)
# ---------------------------------------

# NOTE: Currently using local filesystem
# Future Example (S3 / R2):
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=dayonegoal-bucket
# AWS_S3_REGION_NAME=ap-south-1


# ---------------------------------------
# LLM PROVIDERS
# ---------------------------------------

# Base Ollama host (OPTIONAL)
# Example: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Default Ollama model (OPTIONAL)
# Example: gpt-oss:20b
OLLAMA_MODEL=gpt-oss:120b-cloud

# Override model for goal hierarchy generation (OPTIONAL)
# Example: llama3:latest
HIERARCHY_MODEL=gpt-oss:120b-cloud

# Override model for Journey Book generation (OPTIONAL)
# Example: mistral:7b
JOURNEYBOOK_MODEL=gpt-oss:120b-cloud

# Ollama request timeout in seconds (OPTIONAL)
# Example: 180
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# Ollama retry count (OPTIONAL)
# Example: 2
OLLAMA_MAX_RETRIES=2

# Retry backoff in seconds (OPTIONAL)
# Example: 0.75
OLLAMA_RETRY_BACKOFF_SECONDS=0.75

# Allow proxy env usage (OPTIONAL)
# Example: false
OLLAMA_TRUST_ENV=false

# Enable extra AI debug logging (OPTIONAL)
# Example: true
AI_DEBUG=false

# Journal AI provider (OPTIONAL)
# Example: ollama / openai / claude
JOURNAL_AI_PROVIDER=

# Hugging Face API key (OPTIONAL)
# Example: hf_xxxxxxxxxxxxxxxxx
HUGGINGFACE_API_KEY=replace-with-your-huggingface-api-key


# ---------------------------------------
# SECURITY
# ---------------------------------------

# Max active refresh-token sessions per user
# Example: 5 (limit devices), 0 (unlimited)
MAX_ACTIVE_DEVICE_SESSIONS=0


# ---------------------------------------
# OPTIONAL / FEATURE FLAGS
# ---------------------------------------

# GIE rollout master switch
# Example: True
GIE_ROLLOUT_ENABLED=True

# GIE degraded mode switch
# Example: False
GIE_DEGRADED_MODE=False

# Max months allowed in AI hierarchy planning
# Example: 12
HIERARCHY_MAX_MONTHS=12

# Max subgoals per milestone
# Example: 3
HIERARCHY_MAX_SUBGOALS_PER_MILESTONE=3

# Max tasks per subgoal
# Example: 5
HIERARCHY_MAX_TASKS_PER_SUBGOAL=5

# Max tokens for hierarchy generation
# Example: 2400
HIERARCHY_MAX_TOKENS=2400

# Worker count for hierarchy generation
# Example: 2
HIERARCHY_TASK_WORKERS=2

# JWT access token lifetime (minutes)
# Example: 60
ACCESS_TOKEN_LIFETIME_MINUTES=60

# JWT refresh token lifetime (days)
# Example: 7
REFRESH_TOKEN_LIFETIME_DAYS=7


# -----------------------------------
# SETUP INSTRUCTIONS
# -----------------------------------
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Replace placeholder values using examples above
#
# 3. Never commit .env to Git