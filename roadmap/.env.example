# ==============================================================================
# DAYONEGOAL — BACKEND ENVIRONMENT
# roadmap-smart-planner-backend/roadmap/.env.example
# ==============================================================================
#
# QUICK START
#   1. cp roadmap/.env.example roadmap/.env
#   2. Fill in every value marked [REPLACE].
#   3. Values marked [DEV DEFAULT] work on localhost without changes.
#   4. Values marked [PROD CHANGE] must be updated before deploying.
#
# LOCALHOST vs PRODUCTION SUMMARY
# ┌─────────────────────────┬──────────────────────────────┬─────────────────────────────────────┐
# │ Setting                 │ Localhost                    │ Production (Render)                 │
# ├─────────────────────────┼──────────────────────────────┼─────────────────────────────────────┤
# │ DEBUG                   │ True                         │ False                               │
# │ DB_ENGINE               │ (empty = SQLite) or postgres │ django.db.backends.postgresql       │
# │ LLM_PRIMARY_PROVIDER    │ ollama                       │ groq                                │
# │ JOURNAL_AI_PROVIDER     │ ollama                       │ groq                                │
# │ USE_R2_STORAGE          │ False                        │ True                                │
# │ REDIS_URL               │ redis://localhost:6379/0     │ Render Redis internal URL           │
# │ CELERY_TASK_ALWAYS_EAGER│ True (no worker needed)      │ False (real Celery worker)          │
# │ SENTRY_DSN              │ (empty)                      │ Your Sentry DSN                     │
# │ ALLOWED_HOSTS           │ localhost,127.0.0.1          │ + your-service.onrender.com         │
# │ CORS_ALLOWED_ORIGINS    │ http://localhost:3000        │ https://your-app.vercel.app         │
# └─────────────────────────┴──────────────────────────────┴─────────────────────────────────────┘
#
# ==============================================================================


# ------------------------------------------------------------------------------
# DJANGO CORE
# ------------------------------------------------------------------------------

# Enables Django's debug error pages and the browsable DRF API renderer.
# Never set True in production — it exposes stack traces to the public.
# [DEV DEFAULT] True
# [PROD CHANGE] False
DEBUG=False

# Environment label used by logging configuration and deployment guards.
# Settings will enforce extra checks (e.g. required env vars) when set to production.
# [DEV DEFAULT] development
# [PROD CHANGE] production
DJANGO_ENV=development

# Long random string Django uses to sign cookies, sessions, and cryptographic tokens.
# Generate a new one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# [REPLACE] Use a unique value per environment — never share dev and prod keys.
DJANGO_SECRET_KEY=replace-with-a-strong-random-secret-key

# Comma-separated list of hostnames Django is allowed to serve.
# Requests with a Host header not on this list will be rejected with HTTP 400.
# [DEV DEFAULT] localhost,127.0.0.1,::1
# [PROD CHANGE] Add your Render hostname, e.g. your-service.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1,::1,your-service.onrender.com

# Comma-separated list of frontend origins allowed to make cross-site requests (CORS).
# Must include every origin your frontend is served from, including preview URLs.
# [DEV DEFAULT] http://localhost:3000,http://127.0.0.1:3000
# [PROD CHANGE] https://your-app.vercel.app (remove localhost entries)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex that also allows CORS — matches all Vercel preview deployment URLs automatically.
# Safe to leave unchanged in both dev and prod.
CORS_ALLOWED_ORIGIN_REGEXES=^https://[a-z0-9-]+\.vercel\.app$

# Origins trusted to send CSRF tokens (Django's cross-site form protection).
# Must include every origin your frontend form submissions come from.
# [DEV DEFAULT] http://localhost:3000
# [PROD CHANGE] https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# How long (seconds) browsers may cache static files served by WhiteNoise.
# 31536000 = 1 year. Safe to leave unchanged in all environments.
WHITENOISE_MAX_AGE=31536000


# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
#
# Leave DB_ENGINE empty to use SQLite (zero-config, fine for solo local dev).
# Set DB_ENGINE and all DB_* vars to use PostgreSQL (required for production).
#
# Supabase connection details are found at:
#   Supabase Dashboard → Project Settings → Database → Connection string
# ------------------------------------------------------------------------------

# Django database backend driver.
# [DEV DEFAULT] (empty string) — falls back to SQLite automatically
# [PROD CHANGE] django.db.backends.postgresql
DB_ENGINE=

# Database name. For Supabase this is always "postgres".
# Only used when DB_ENGINE is set.
DB_NAME=postgres

# Database username. For Supabase this is always "postgres".
# Only used when DB_ENGINE is set.
DB_USER=postgres

# [REPLACE] Your Supabase database password.
# Found at: Supabase → Project Settings → Database → Database password
DB_PASSWORD=replace-with-your-supabase-db-password

# [REPLACE] Your Supabase project host.
# Format: db.<project-ref>.supabase.co
# Found at: Supabase → Project Settings → Database → Host
DB_HOST=db.your-project-ref.supabase.co

# PostgreSQL port. Supabase uses the standard 5432. Do not change.
DB_PORT=5432

# Seconds a database connection is kept open and reused between requests.
# 60 is a safe default. Set to 0 to disable persistent connections.
DB_CONN_MAX_AGE=60

# Runs a lightweight health check before reusing a persistent connection.
# Prevents stale-connection errors after network interruptions.
DB_CONN_HEALTH_CHECKS=True

# Supabase requires SSL on all connections. Do not change this.
DB_SSLMODE=require


# ------------------------------------------------------------------------------
# AUTHENTICATION & JWT
# ------------------------------------------------------------------------------

# How long (minutes) an access token remains valid before the client must refresh it.
# Shorter = more secure but more refresh calls. 60 minutes is a common default.
ACCESS_TOKEN_LIFETIME_MINUTES=60

# How long (days) a refresh token remains valid before the user must log in again.
REFRESH_TOKEN_LIFETIME_DAYS=7

# Max number of concurrent active device sessions per user.
# 0 = unlimited (recommended for MVP). Set to e.g. 5 to cap multi-device sessions.
MAX_ACTIVE_DEVICE_SESSIONS=0

# Frontend URL where the password reset form lives.
# Injected into the reset-password email as a clickable link.
# [DEV DEFAULT] http://localhost:3000/reset-password
# [PROD CHANGE] https://your-app.vercel.app/reset-password
PASSWORD_RESET_URL=http://localhost:3000/reset-password


# ------------------------------------------------------------------------------
# GOOGLE OAUTH
# ------------------------------------------------------------------------------

# Google OAuth 2.0 web client ID.
# Must exactly match NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend .env.local.
# Created at: https://console.cloud.google.com → APIs & Services → Credentials
# [REPLACE] Your Google OAuth web client ID.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id

# Whether the backend verifies Google's SSL certificate when validating ID tokens.
# Keep True in production. Only set False if your local machine has broken CA trust
# and Google cert verification fails during development.
# [DEV DEFAULT] False (only if needed) | [PROD CHANGE] True
GOOGLE_VERIFY_SSL=True


# ------------------------------------------------------------------------------
# MAGIC LINK AUTHENTICATION
# ------------------------------------------------------------------------------

# How long (seconds) a magic link sign-in token remains valid after being issued.
# 900 = 15 minutes. Shorter = more secure; longer = more forgiving for slow email.
MAGIC_LINK_TOKEN_MAX_AGE_SECONDS=900

# Frontend URL that magic link emails point to.
# The token is appended as a query parameter by the backend.
# [DEV DEFAULT] http://localhost:3000/auth/magic
# [PROD CHANGE] https://your-app.vercel.app/auth/magic
MAGIC_LINK_URL=http://localhost:3000/auth/magic


# ------------------------------------------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE
# ------------------------------------------------------------------------------
#
# R2 stores user-uploaded files and generated PDFs (Journey Book exports, etc.).
# In local dev, files are written to the local filesystem — no R2 account needed.
# In production, enable R2 so files persist across Render deploys.
#
# Setup: https://dash.cloudflare.com → R2 → Create bucket → API Tokens
# ------------------------------------------------------------------------------

# Master switch for R2 storage. False = local filesystem. True = Cloudflare R2.
# [DEV DEFAULT] False | [PROD CHANGE] True
USE_R2_STORAGE=False

# R2 S3-compatible API endpoint.
# [REPLACE] Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Name of the R2 bucket you created for this project.
# [REPLACE] Your bucket name, e.g. dayonegoal-storage
R2_BUCKET_NAME=dayonegoal-storage

# R2 API token access key ID.
# [REPLACE] From: Cloudflare Dashboard → R2 → Manage API Tokens
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id

# R2 API token secret access key.
# [REPLACE] Shown once at token creation time — store it securely.
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key

# Public base URL used to construct file URLs returned to the frontend.
# [REPLACE] Format: https://pub-<HASH>.r2.dev (enable public access on the bucket first)
R2_PUBLIC_BASE_URL=https://pub-YOUR_HASH.r2.dev


# ------------------------------------------------------------------------------
# EMAIL & COMMUNICATIONS (Resend)
# ------------------------------------------------------------------------------
#
# Resend handles transactional email (magic links, password resets, commitment contracts).
# In dev you can use the Resend sandbox address (onboarding@resend.dev) for free
# without verifying a domain. In production you must verify your sending domain.
#
# Setup: https://resend.com → API Keys + Domains
# ------------------------------------------------------------------------------

# Django email backend. Use smtp for Resend in both dev and prod.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# [REPLACE] Your Resend API key. Found at: https://resend.com/api-keys
RESEND_API_KEY=replace-with-your-resend-api-key

# Display name and sending address for all outbound emails.
# [DEV DEFAULT] Use onboarding@resend.dev (Resend sandbox, no domain verification needed)
# [PROD CHANGE] Your verified domain address, e.g. DayOneGoal <hello@dayonegoal.site>
RESEND_FROM_EMAIL=DayOneGoal <onboarding@resend.dev>

# Fallback "from" address used by Django's own email utilities (e.g. error emails).
# [PROD CHANGE] Match your verified sending domain.
DEFAULT_FROM_EMAIL=noreply@yourdomain.com


# ------------------------------------------------------------------------------
# REDIS & CELERY
# ------------------------------------------------------------------------------
#
# Celery runs background tasks (e.g. AI job processing, email delivery).
# In local dev, set CELERY_TASK_ALWAYS_EAGER=True so tasks run inline —
# no Redis server or separate Celery worker process required.
# In production, use a real Redis instance and run a dedicated Celery worker.
# ------------------------------------------------------------------------------

# Redis connection URL used as the Celery broker and result backend.
# [DEV DEFAULT] redis://localhost:6379/0 (requires local Redis or Docker)
# [PROD CHANGE] Your Render Redis internal URL:
#   redis://red-<id>.oregon-postgres.render.com:6379
#   Found at: Render Dashboard → Your Redis service → Internal URL
REDIS_URL=redis://localhost:6379/0

# Runs Celery tasks synchronously in the same process instead of through Redis.
# Eliminates the need for a running Redis server and Celery worker in local dev.
# [DEV DEFAULT] True | [PROD CHANGE] False
CELERY_TASK_ALWAYS_EAGER=True

# When eager mode is on, re-raises task exceptions immediately in the caller.
# Useful for catching task bugs during local development.
# [DEV DEFAULT] True | [PROD CHANGE] False
CELERY_TASK_EAGER_PROPAGATES=True


# ------------------------------------------------------------------------------
# LLM — GLOBAL CONFIGURATION
# ------------------------------------------------------------------------------
#
# DayOneGoal uses a provider-routing layer (roadmap/ai/config.py) that maps
# feature-level model keys (e.g. LLAMA_3_3_70B) to real API calls.
#
# Provider routing order:
#   1. LLM_PRIMARY_PROVIDER handles the request.
#   2. If it fails, LLM_FALLBACKS are tried left-to-right.
#
# Local dev:  set LLM_PRIMARY_PROVIDER=ollama (free, no API key needed)
# Production: set LLM_PRIMARY_PROVIDER=groq   (free tier, fast, cloud-hosted)
# ------------------------------------------------------------------------------

# Which provider handles all LLM requests by default.
# [DEV DEFAULT] ollama | [PROD CHANGE] groq
LLM_PRIMARY_PROVIDER=groq

# Ordered fallback chain if the primary provider fails.
# Format: provider:MODEL_KEY,provider:MODEL_KEY,...
# [DEV DEFAULT] ollama:GPT_OSS_120B
# [PROD CHANGE] openrouter:LLAMA_3_3_70B,ollama:GPT_OSS_120B
LLM_FALLBACKS=openrouter:LLAMA_3_3_70B,ollama:GPT_OSS_120B

# Seconds before an LLM API call times out and triggers a retry or fallback.
LLM_REQUEST_TIMEOUT_SECONDS=60

# Maximum number of retry attempts on a failed LLM call before giving up.
LLM_MAX_RETRIES=1

# Seconds to wait between retry attempts (simple backoff).
LLM_RETRY_BACKOFF_SECONDS=1.0

# Logs full LLM request and response payloads to the console for debugging.
# Keep False in production — outputs can contain user data.
AI_DEBUG=False


# ------------------------------------------------------------------------------
# LLM — MODEL ROUTING (per feature)
# ------------------------------------------------------------------------------
#
# Each variable maps a DayOneGoal feature to a generic model key.
# The routing layer resolves the key to the correct provider-specific model string.
#
# Available keys:
#   LLAMA_3_3_70B  → resolved to llama-3.3-70b-versatile on Groq / OpenRouter
#   GPT_OSS_120B   → resolved to gpt-oss:120b-cloud on Ollama (local only)
#
# In production, all features should use LLAMA_3_3_70B (cloud-hosted, no local GPU).
# In local dev, you can switch any feature to GPT_OSS_120B to use your local Ollama.
# ------------------------------------------------------------------------------

HIERARCHY_MODEL=LLAMA_3_3_70B
JOURNEYBOOK_MODEL=LLAMA_3_3_70B
TIMELINE_MODEL=LLAMA_3_3_70B
CURRENT_SITUATION_MODEL=LLAMA_3_3_70B
GIE_LANGUAGE_MODEL=LLAMA_3_3_70B
JOURNAL_MODEL=LLAMA_3_3_70B
HABIT_RECOMMENDATION_MODEL=LLAMA_3_3_70B
GOAL_ATTRIBUTE_MODEL=LLAMA_3_3_70B
GOAL_CATEGORY_MODEL=LLAMA_3_3_70B


# ------------------------------------------------------------------------------
# LLM — GROQ PROVIDER
# ------------------------------------------------------------------------------
#
# Groq is the production primary provider. It offers a free tier with generous
# rate limits for Llama 3.3 70B — ideal for DayOneGoal's MVP scale.
#
# Setup: https://console.groq.com → API Keys → Create key
# ------------------------------------------------------------------------------

# [REPLACE] Your Groq API key.
GROQ_API_KEY=your-groq-api-key

# Groq's OpenAI-compatible API base URL. Do not change.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Generic model key used by the routing layer for Groq requests.
# Maps internally to the model string in GROQ_LLAMA_MODEL below.
GROQ_MODEL=LLAMA_3_3_70B

# Actual Groq model identifier sent in API calls.
# This must match a model available on your Groq plan.
GROQ_LLAMA_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------------------------
# LLM — OPENROUTER PROVIDER (fallback)
# ------------------------------------------------------------------------------
#
# OpenRouter aggregates dozens of model providers behind one API.
# Used as the first cloud fallback when Groq is unavailable or rate-limited.
# Free models are available — check https://openrouter.ai/models?q=free
#
# Setup: https://openrouter.ai/keys → Create key
# ------------------------------------------------------------------------------

# [REPLACE] Your OpenRouter API key.
OPENROUTER_API_KEY=your-openrouter-api-key

# OpenRouter API base URL. Do not change.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Generic model key for OpenRouter routing.
OPENROUTER_MODEL=LLAMA_3_3_70B

# App name sent in the HTTP Referer header (used by OpenRouter for attribution).
OPENROUTER_APP_NAME=DayOneGoal

# [PROD CHANGE] Your production frontend URL, sent in X-Title header to OpenRouter.
OPENROUTER_SITE_URL=https://your-app.vercel.app


# ------------------------------------------------------------------------------
# LLM — OLLAMA (local development only)
# ------------------------------------------------------------------------------
#
# Ollama runs open-source models on your local machine. It is the recommended
# provider for local development because it requires no API key or internet access.
# Ollama is NOT available in production (Render does not provide GPU resources).
#
# Setup: https://ollama.com/download → install → `ollama pull gpt-oss:120b-cloud`
# Switch to Ollama: set LLM_PRIMARY_PROVIDER=ollama and JOURNAL_AI_PROVIDER=ollama
# ------------------------------------------------------------------------------

# URL where Ollama is listening. Default after installation is http://localhost:11434.
# [DEV DEFAULT] http://localhost:11434
# [PROD] Not used — keep the default value, the primary provider will be groq.
OLLAMA_HOST=http://localhost:11434

# Generic model key used by the routing layer for Ollama requests.
# Maps to the model name you pulled with `ollama pull`.
OLLAMA_MODEL=GPT_OSS_120B

# Timeout (seconds) for Ollama requests. Local models are slower than cloud APIs,
# so this is intentionally longer than LLM_REQUEST_TIMEOUT_SECONDS.
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.75

# Prevents the Ollama HTTP client from reading proxy configuration from the environment.
# Keep False unless you need to route Ollama traffic through a proxy.
OLLAMA_TRUST_ENV=False

# Which provider powers the Journey Book AI feature specifically.
# [DEV DEFAULT] ollama | [PROD CHANGE] groq
JOURNAL_AI_PROVIDER=ollama


# ------------------------------------------------------------------------------
# ROADMAP HIERARCHY CONSTRAINTS
# ------------------------------------------------------------------------------
#
# These control how much content the AI generates when building a goal hierarchy
# (milestones → subgoals → tasks). Raising them increases AI cost and response time.
# The defaults below are tuned for cost-efficient MVP usage.
# ------------------------------------------------------------------------------

# Maximum number of months a generated goal plan can span.
HIERARCHY_MAX_MONTHS=12

# Maximum subgoals generated per milestone.
HIERARCHY_MAX_SUBGOALS_PER_MILESTONE=3

# Maximum tasks generated per subgoal.
HIERARCHY_MAX_TASKS_PER_SUBGOAL=5

# Token budget for the hierarchy generation prompt and response combined.
# 2400 is cost-efficient for MVP. Raise to 4096+ only if output is being truncated.
HIERARCHY_MAX_TOKENS=2400

# Number of parallel workers used during task generation within a hierarchy.
# [DEV DEFAULT] 1 (simpler debugging) | [PROD CHANGE] 2
HIERARCHY_TASK_WORKERS=2


# ------------------------------------------------------------------------------
# GIE (GOAL INTELLIGENCE ENGINE) ROLLOUT FLAGS
# ------------------------------------------------------------------------------

# Master switch for all public GIE API endpoints.
# Set to False to hide GIE features globally without code changes.
GIE_ROLLOUT_ENABLED=True

# Forces GIE to return degraded/rule-based responses instead of LLM calls.
# Useful as an emergency kill switch if the AI provider hits quota or goes down.
GIE_DEGRADED_MODE=False


# ------------------------------------------------------------------------------
# MONITORING (Sentry)
# ------------------------------------------------------------------------------
#
# Sentry captures unhandled exceptions and slow transactions in production.
# Leave SENTRY_DSN empty in local dev to disable Sentry entirely.
#
# Setup: https://sentry.io → New Project → Django → copy DSN
# ------------------------------------------------------------------------------

# [REPLACE] Your Sentry DSN. Leave empty to disable Sentry.
# [DEV DEFAULT] (empty) | [PROD CHANGE] https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_DSN=

# Set to True to disable Sentry even when SENTRY_DSN is set (emergency override).
DISABLE_SENTRY=False

# Fraction (0.0–1.0) of requests to send as performance traces.
# 0 = disabled. 0.1 = 10% sampling. Keep low in production to control Sentry quota.
SENTRY_TRACES_SAMPLE_RATE=0

# Fraction (0.0–1.0) of transactions to profile. 0 = disabled.
SENTRY_PROFILES_SAMPLE_RATE=0

# Attaches user identity (email, username) to Sentry error reports.
# Keep False unless your privacy policy explicitly allows this.
SENTRY_SEND_DEFAULT_PII=False


# ------------------------------------------------------------------------------
# EXTERNAL TOOLS
# ------------------------------------------------------------------------------

# Hugging Face API key — used for AI illustration generation on goal cards.
# [REPLACE] From: https://huggingface.co/settings/tokens → New token (read access is enough)
HUGGINGFACE_API_KEY=replace-with-your-huggingface-api-key