DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-local-dev-secret-key
ALLOWED_HOSTS=your-service.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_URL=http://localhost:3000/reset-password

RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Roadmap Smart Planner <onboarding@example.com>

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
HIERARCHY_MODEL=gpt-oss:120b-cloud
JOURNEYBOOK_MODEL=gpt-oss:120b-cloud
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_MAX_RETRIES=2
OLLAMA_RETRY_BACKOFF_SECONDS=0.75
OLLAMA_TRUST_ENV=false
AI_DEBUG=false
JOURNAL_AI_PROVIDER=
HUGGINGFACE_API_KEY=replace-with-your-huggingface-api-key

DB_ENGINE=django.db.backends.postgresql
DB_NAME=your-supabase-db-name
DB_USER=your-supabase-db-user
DB_PASSWORD=replace-with-your-supabase-db-password
DB_HOST=your-project-id.supabase.co
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

MAX_ACTIVE_DEVICE_SESSIONS=0
GIE_ROLLOUT_ENABLED=True
GIE_DEGRADED_MODE=False
HIERARCHY_MAX_MONTHS=12
HIERARCHY_MAX_SUBGOALS_PER_MILESTONE=3
HIERARCHY_MAX_TASKS_PER_SUBGOAL=5
HIERARCHY_MAX_TOKENS=2400
HIERARCHY_TASK_WORKERS=2
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
